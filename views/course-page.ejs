<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/common-title') %>
    <link rel="stylesheet" href="/css/course-page.css">
</head>

<body>
    <%- include('partials/sidemenu') %>
    <div class="main-content">
        <h2>Course</h2>
        <div class="container">
            <div class="table-container" id="courseContainer">
                <!-- Cards will be dynamically added here -->
            </div>
            <button id="addCourseButton">Add New Course</button>
        </div>
    </div>
    <!-- The Modal for adding new course -->
    <div id="courseFormModal" class="form-container">
        <div class="form-content">
            <span class="close">&times;</span>
            <h2>Add New Course</h2>
            <form id="courseForm">
                <label for="name">Name:</label>
                <input type="text" id="name" name="name" required>
                <label for="fees">Fees:</label>
                <input type="text" id="fees" name="fees" required>
                <button type="submit">Add Course</button>
            </form>
        </div>
    </div>
    <script src="/js/course-page.js"></script>
</body>

</html>