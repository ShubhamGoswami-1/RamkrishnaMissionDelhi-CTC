<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/css/all-admissions.css">

    <%- include('partials/common-title') %>
</head>
<body>
    <%- include('partials/sidemenu') %>

    <div class="main-content">
        <h2>All Admissions</h2>

        <div class="search-container">
            <input type="text" id="searchInput" placeholder="Search...">
            <img src="/images/filter-blue-icon.jpeg" alt="Filter Icon" id="filterIcon">
            <div class="search-dropdown" id="searchDropdown">
                <select id="searchCategory">
                    <option value="studentName">Student Name</option>
                    <option value="courseName">Course</option>
                    <option value="batchTitle">Batch</option>
                </select>
            </div>
        </div>
        
        <div class="table-container">
            <table id="admissionTable">
                <thead>
                    <tr>
                        <th>Student Name</th>
                        <th>Course</th>
                        <th>Batch</th>
                        <th>Admission Date</th>
                        <th>Form No</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Dynamic rows will be inserted here -->
                </tbody>
            </table>
        </div>
    </div>
    <script src="/js/all-admissions.js"></script>
</body>
</html>
