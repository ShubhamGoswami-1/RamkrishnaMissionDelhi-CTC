<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/common-title') %>
    <link rel="stylesheet" href="/css/faculty-detail-page.css">
</head>
<body>
    <%- include('partials/sidemenu') %>
    <div class="main-content" data-faculty-id="<%= facultyId %>">
        <h2>Faculty Details</h2>

        <!-- Personal Details Container -->
        <div class="details-container">
            <h3>Personal Details</h3>
            <form id="personalDetailsForm">
                <div class="form-row">
                    <div class="form-group">
                        <label for="name">Name:</label>
                        <input type="text" id="name" name="name">
                        <span id="nameError" class="error-message"></span>
                    </div>
                    <div class="form-group">
                        <label for="email">Email:</label>
                        <input type="email" id="email" name="email">
                        <span id="emailError" class="error-message"></span>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="aadhaarNo">Aadhaar No:</label>
                        <input type="text" id="aadhaarNo" name="aadhaarNo">
                        <span id="aadhaarNoError" class="error-message"></span>
                    </div>
                    <div class="form-group">
                        <label for="phone">Phone:</label>
                        <input type="text" id="phone" name="phone">
                        <span id="phoneError" class="error-message"></span>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="address">Address:</label>
                        <textarea id="address" name="address"></textarea>
                        <span id="addressError" class="error-message"></span>
                    </div>
                </div>
                <button type="button" id="saveDetailsButton">Save Details</button>
            </form>
        </div>

        <!-- Batch/Course IDs Container -->
        <div class="details-container">
            <h3>Enrolled Courses</h3>
            <table id="batchCourseTable">
                <thead>
                    <tr>
                        <th>Course</th>
                        <th>Batch</th>
                        <th>Timing</th>
                        <th>Starting Date</th>
                        <th>No. of Students</th>
                        <th>Fees</th>
                        <!-- <th>GST Fees</th> -->
                        <!-- <th>Expected Fees</th> -->
                        <th>Expected Fees with GST</th>
                        <th>Total Fees Paid</th>
                        <th>Total Fees Due</th>
                        <th>Active</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Batch/Course details will be populated here -->
                </tbody>
            </table>
        </div>
    </div>
    <script src="/js/faculty-detail-page.js"></script>
</body>
</html>